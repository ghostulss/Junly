{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"%E5%85%B3%E4%BA%8E%E6%88%91/%E8%AF%B4%E6%98%8E%E4%B9%A6/","title":"\u8715\u53d8\u65f6\u4ee3","text":"<p>\" \u8471\u8471\u884c\u8005\uff0c\u65e0\u7586\u65e0\u79cb\u3002\u6765\u4e5f\u8471\u5306\uff0c\u53bb\u4e5f\u8471\u5306\" </p>"},{"location":"%E5%85%B3%E4%BA%8E%E6%88%91/%E8%AF%B4%E6%98%8E%E4%B9%A6/#my-name-is-junly","title":"My Name is Junly","text":"<ul> <li>\u6211\u662f\u4e00\u540d\u5408\u80a5\u5de5\u4e1a\u5927\u5b66\u7684\u5927\u4e00\u5b66\u751f\uff0c\u76ee\u524d\u5b66\u4e60\u5730\u7403\u4fe1\u606f\u79d1\u5b66\u4e0e\u6280\u672f\u3002\u70ed\u8877\u4e8e\u63a2\u7d22CS\u7684\u4e16\u754c\u3002\u6700\u5927\u7684\u7279\u70b9\u662f\u4e00\u4e2a\u201c\u751f\u6d3b\u5316\u5b66\u8005\u201d(\u8bdd\u8bf4\u771f\u7684\u6709\u8fd9\u79cd\u79f0\u547c\u5417\u2753)\u559c\u6b22\u63a2\u7d22\u4e00\u4e9b\u7a00\u5947\u53e4\u602a\u7684\u4e1c\u897f\u3002\u5e73\u65f6\u6700\u7231\u505a\u996d\u548c\u6f14\u8bf4\u3002\u5f53\u7136\u5f53\u7136\u4e5f\u5305\u62ec\u8d5b\u535a\u751f\u6d3b\ud83d\ude03\u4e0a\u7f51\u51b2\u6d6a\u83ab\u4e0d\u60ec\u610f\u3002\u505a\u8fd9\u4e48\u4e2ablog\u4e5f\u662f\u60f3\u4ee5\u66f4\u65b0\u9c9c\u7684\u65b9\u5f0f\u8ba4\u8bc6\u5927\u5bb6\u3002\u6b22\u8fce\u8054\u7cfb\u6211\u8fdb\u884c\u4e00\u4e9b\u4ea4\u6d41\uff0c\u5439\u6c34\uff0c\u73a9Overwatch(bushi)</li> </ul>"},{"location":"%E5%85%B3%E4%BA%8E%E6%88%91/%E8%AF%B4%E6%98%8E%E4%B9%A6/#_2","title":"\u5b66\u4e60","text":"<pre><code>printf(\"CS On-Diving\");\n</code></pre> <ul> <li>\u76ee\u524d\u4e3b\u653bdata structure,\u8fd8\u8981\u62bd\u65f6\u95f4\u8865\u5b8cCS50\uff0c\u56e0\u4e3a\u60f3\u505a\u4e2a\u6f02\u4eae\u7f51\u7ad9\u8fd8\u5728\u5b66\u4e60CSS\u4e0eJavascript\u3002    \u6700\u5e38\u505a\u7684\u4e8b\u60c5\u662f\u5237\u9898\uff0c\u54c8\u5de5\u5927\u7a0b\u8bbe\u624b\u5199\u9009\u624b\u3002\u4f46\u8fd8\u5728\u7422\u78e8\u9012\u63a8\u4e0e\u9012\u5f52</li> </ul>"},{"location":"%E5%85%B3%E4%BA%8E%E6%88%91/%E8%AF%B4%E6%98%8E%E4%B9%A6/#you-can-find","title":"You can Find","text":"<ul> <li>\u6b22\u8fce\u6765\u6211\u7684\u4ed3\u5e93\u4ea4\u6d41\uff0c\u7531\u4e8e\u672c\u4eba\u4e4b\u524d\u6ca1\u6709\u5f04\u61c2git commit\uff0c\u5bfc\u81f4\u4ed3\u5e93\u7a7a\u7a7a\u5982\u4e5f\ud83d\ude2d\u540e\u7eed\u4e5f\u4f1a\u9646\u9646\u7eed\u7eed\u4e0a\u4f20\u4e0a\u53bb</li> </ul>"}]}